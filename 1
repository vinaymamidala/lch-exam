networks:
  lch-net:
    driver: bridge

services:
  application-service:
    build: ./application-service
    container_name: application-service
    ports:
      - 3000:3000
    environment:
      - SPRING_PROFILES_ACTIVE=dev
    depends_on:
      - order-service
      - patient-service
    networks:
      - lch-net

  order-service:
    build: ./order-service
    container_name: order-service
    ports:
      - 8080:8080
    environment:
      - SPRING_PROFILES_ACTIVE=dev
    networks:
      - lch-net

  patient-service:
    build: ./patient-service
    container_name: patient-service
    ports:
      - 3001:3001
    environment:
      - SPRING_PROFILES_ACTIVE=dev
    networks:
      - lch-net

